# Local demo mode is automatic when QUICKML_ENDPOINT_URL is unset.
# The locally trained model is clearly labelled and is not a QuickML prediction.

# Copy these values from your published Zoho Catalyst QuickML endpoint details.
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
ZOHO_OAUTH_TOKEN=
QUICKML_ORG=
QUICKML_ENVIRONMENT=Development
# Legacy local names CATALYST_ORG and CATALYST_ENVIRONMENT remain supported.
# AppSail rejects these reserved names as user-defined environment variables.

# Optional server settings
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Renewable OAuth credentials (preferred over a manually supplied access token).
# Set all three securely in the backend process; never commit real values.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
