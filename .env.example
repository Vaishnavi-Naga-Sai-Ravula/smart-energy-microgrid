# Local demo mode is automatic when QUICKML_ENDPOINT_URL is unset.
# The locally trained model is clearly labelled and is not a QuickML prediction.

# Copy these values from your published Zoho Catalyst QuickML endpoint details.
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
ZOHO_OAUTH_TOKEN=
CATALYST_ORG=
CATALYST_ENVIRONMENT=Development

# Optional server settings
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
